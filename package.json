{
  "name": "atlas-sillytavern-plugin",
  "version": "0.9.82",
  "private": true,
  "description": "Atlas — SillyTavern 世界引擎扩展（独立项目；内嵌 Atlasia 世界核心快照）",
  "type": "module",
  "scripts": {
    "test": "node --test --no-warnings=ExperimentalWarning --experimental-strip-types \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "node tools/pack.mjs",
    "build": "node tools/build.mjs",
    "sync": "node tools/sync-mirror.mjs",
    "verify:workbench": "node tools/verify-workbench-browser.mjs",
    "verify:host-generation": "node tools/verify-host-generation.mjs",
    "map:lab": "node tools/map-lab/build.mjs",
    "map:verify": "node --experimental-strip-types tools/map-lab/verify.mjs"
  },
  "dependencies": {
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "playwright": "1.63.0",
    "typescript": "^5.9.3"
  },
  "author": "kjngstar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kjngstar/atlas-sillytavern-plugin.git"
  }
}
